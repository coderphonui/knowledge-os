{
  "enabledPlugins": {
    "claude-mem@thedotmack": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "brain/skills/query/.venv/bin/python brain/skills/query/scripts/index.py incremental > /dev/null 2>&1 &"
          }
        ]
      }
    ]
  }
}
