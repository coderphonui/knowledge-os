# ── Query Skill — Optional Config Overrides ───────────────────────────────────
# Copy to config.env and uncomment values to override defaults.
# config.env is gitignored — this .example file is the committed template.
# All values below are optional — the skill works without this file.

# Ollama embedding model (default: bge-m3)
# KB_EMBED_MODEL=bge-m3

# Ollama server URL (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# Max words per chunk when indexing (default: 400)
# KB_CHUNK_WORDS=400
