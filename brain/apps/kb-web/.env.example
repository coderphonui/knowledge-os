# Absolute path to your knowledge-os data folder
# Example: /Users/khoatran/Projects/my-knowledge-os/data
KB_ROOT=/absolute/path/to/your/data

# Optional: override the Ollama Cloud API key used by the Knowledge Agent.
# If omitted, the agent reads the key from ~/.pi/agent/auth.json under "ollama-cloud"
# (the same key pi uses — no extra setup needed if pi is already configured).
# OLLAMA_API_KEY=your-ollama-cloud-key
