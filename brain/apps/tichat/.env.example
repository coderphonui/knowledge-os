# Slack credentials (from api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# Google Gemini API key (you can get it from aistudio.google.com)
GOOGLE_API_KEY=your-google-api-key

# Gemini model (optional, defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# Path to knowledge OS root (defaults to current working directory)
# Set this to the absolute path of your knowledge-os repo
KB_ROOT=/Users/yourname/my-knowledge-os
