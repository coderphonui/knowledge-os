# Slack credentials (from api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# Path to knowledge OS root (defaults to current working directory)
# Set this to the absolute path of your knowledge-os repo
KB_ROOT=/Users/yourname/my-knowledge-os

# Optional: override Ollama Cloud API key here.
# If omitted, tichat reads from ~/.pi/agent/auth.json under "ollama-cloud".
# OLLAMA_API_KEY=your-ollama-cloud-key
